# ==========================================
# Fintech Integration Assessment Environment
# ==========================================

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------
# Apache Fineract Database (PostgreSQL)
# ------------------------------------------
FINERACT_DB_HOST=fineract-db
FINERACT_DB_PORT=5432
FINERACT_DB_NAME=fineract_tenants
FINERACT_DB_USER=fineract
FINERACT_DB_PASSWORD=fineract

# ------------------------------------------
# Apache Fineract Core Banking API
# ------------------------------------------
FINERACT_BASE_URL=https://fineract:8443/fineract-provider/api/v1
FINERACT_TENANT_ID=default
FINERACT_AUTH_USER=mifos
FINERACT_AUTH_PASSWORD=password
FINERACT_INSECURE_SSL=true

# ------------------------------------------
# Integration Service & Mock ERP Database (PostgreSQL)
# ------------------------------------------
APP_DB_HOST=app-db
APP_DB_PORT=5432
APP_DB_USER=fintech
APP_DB_PASSWORD=fintech_secret
INTEGRATION_DB_NAME=integration_db
ERP_DB_NAME=mock_erp_db
DATABASE_URL=postgresql+psycopg2://fintech:fintech_secret@app-db:5432/integration_db

# ------------------------------------------
# Mock ERP Service
# ------------------------------------------
MOCK_ERP_HOST=0.0.0.0
MOCK_ERP_PORT=8001
MOCK_ERP_URL=http://mock-erp:8001

# ------------------------------------------
# Integration Service
# ------------------------------------------
INTEGRATION_SERVICE_HOST=0.0.0.0
INTEGRATION_SERVICE_PORT=8000
INTEGRATION_SERVICE_URL=http://integration-service:8000
API_KEY=test-partner-api-key

